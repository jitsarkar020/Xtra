def mini(L):
    '''Find the smallest element in L'''
    mini = L[0]  
    for x in L:
        if x < mini:
            mini = x
    return mini

def Sort(L):
    '''Recursively sort the list L'''
    if not L:  
        return []  
    
    m = mini(L)  
    L.remove(m)  
    return [m] + Sort(L)

L = [5, 25, 565, 78, 6, 48, 32, 7]
