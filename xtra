def comp(p,n):
    if (n==1):
        return p*(1.1)
    else:
        return (comp(p, n-1))*1.1

print(comp(10,5))    



def fact(n):
    if (n==1):
        return 1
    else:
        return (fact(n-1))*n #Fact(n)=n*[Fact(n-1)] 
    
print(fact(5))    




